{
    "name": "unione-repo/unione-symfony-bundle",
    "version": "2.1.2",
    "description": "UniOne Web API for Symfony: API client services, Symfony Mailer transport, webhooks",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "unione",
        "symfony",
        "bundle",
        "mailer",
        "email",
        "webhook"
    ],
    "homepage": "https://github.com/unione-repo/unione-symfony",
    "require": {
        "php": ">=8.1",
        "unione-repo/unione-php-sdk": "^2.1.2",
        "symfony/config": "^6.4|^7.0",
        "symfony/dependency-injection": "^6.4|^7.0",
        "symfony/event-dispatcher": "^6.4|^7.0",
        "symfony/http-foundation": "^6.4|^7.0",
        "symfony/http-kernel": "^6.4|^7.0",
        "symfony/mailer": "^6.4|^7.0",
        "symfony/routing": "^6.4|^7.0"
    },
    "autoload": {
        "psr-4": {
            "UniOne\\Wrapper\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
